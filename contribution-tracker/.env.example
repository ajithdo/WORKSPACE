# Folder that holds the database (app.db) and uploaded files. Back this folder up.
DATA_DIR=./data
# Set to "true" when the app is served over HTTPS (recommended in production).
COOKIE_SECURE=false
# Maximum upload size for evidence files, in megabytes.
MAX_UPLOAD_MB=15

# Optional: turns on the AI features (completion check, niche research). Set ONE of these keys,
# here on the server only. Never paste a key into a chat or into the app.
#
# Free: an OpenRouter key from https://openrouter.ai/settings/keys. Uses OpenRouter's free models
# (openrouter/free). Niche research then works from the model's own knowledge, without live web search.
OPENROUTER_API_KEY=
# Live web search through OpenRouter costs credits even with a free model. "true" turns it on.
# OPENROUTER_WEB_SEARCH=false
#
# Paid, best quality: an Anthropic key from https://console.anthropic.com. Claude always searches the web.
ANTHROPIC_API_KEY=
#
# Optional overrides. AI_MODEL defaults to openrouter/free with OpenRouter and claude-opus-5-5 with Anthropic.
# AI_MODEL=
# AI_EFFORT=medium
# If both keys are set, Anthropic is used unless AI_PROVIDER=openrouter.
# AI_PROVIDER=
# AI requests allowed per day across the studio (0 = no limit). The site check is free and not counted.
# AI_DAILY_LIMIT=20

# Automatic daily database copy into DATA_DIR/backups; how many days to keep (0 = off).
# AUTO_BACKUP_DAYS=14

# Optional: GitHub push webhook. Commits that name a task code ("AI-05: add sitemap") become evidence.
# Any long random text; use the same value as the webhook's secret in GitHub.
# GITHUB_WEBHOOK_SECRET=
