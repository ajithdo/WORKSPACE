# Folder that holds the database (app.db) and uploaded files. Back this folder up.
DATA_DIR=./data
# Set to "true" when the app is served over HTTPS (recommended in production).
COOKIE_SECURE=false
# Maximum upload size for evidence files, in megabytes.
MAX_UPLOAD_MB=15

# Optional: turns on the Claude features (completion check, niche research).
# Create a key at https://console.anthropic.com and paste it here, on the server only.
ANTHROPIC_API_KEY=
# Optional overrides for the assistant.
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
# Claude requests allowed per day across the studio (0 = no limit). The site check is free and not counted.
# AI_DAILY_LIMIT=20

# Automatic daily database copy into DATA_DIR/backups; how many days to keep (0 = off).
# AUTO_BACKUP_DAYS=14

# Optional: GitHub push webhook. Commits that name a task code ("AI-05: add sitemap") become evidence.
# Any long random text; use the same value as the webhook's secret in GitHub.
# GITHUB_WEBHOOK_SECRET=
